# ---------------------------------------------------------------------------
# Universal Video Player — configuration
#
# Every value has a working default; copy this file to `.env.local` only to
# change one. No secrets are required to run the app.
# ---------------------------------------------------------------------------

# --- Outbound requests -----------------------------------------------------

# Wall-clock budget for a single outbound request, in milliseconds.
# One resolution is allowed twice this in total (page fetch + playlist probes).
RESOLVER_TIMEOUT_MS=10000

# Redirect hops followed while resolving. Every hop is re-checked against the
# SSRF policy before it is followed.
MAX_REDIRECTS=5

# Maximum bytes of an embed page buffered into memory. Larger pages are
# truncated rather than rejected.
MAX_HTML_BYTES=3000000

# --- Caching ---------------------------------------------------------------

# How long a resolved result is reused, in seconds. Keep this short: many
# providers hand out signed URLs that expire. Set to 0 to disable caching.
CACHE_TTL_SECONDS=300

# Maximum number of cached results held in process memory (LRU).
CACHE_MAX_ENTRIES=500

# --- Rate limiting ---------------------------------------------------------

# Requests allowed per client per window, on POST /api/resolve.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- Browser rendering (optional) ------------------------------------------

# Render pages with Playwright when static extraction finds nothing.
# Requires `npm install -D playwright && npx playwright install chromium`.
# Off by default: it is slow, and most pages do not need it.
ENABLE_BROWSER_RESOLVER=false
BROWSER_TIMEOUT_MS=20000

# --- Host policy -----------------------------------------------------------

# Comma-separated allowlist of hostnames that may be resolved. Subdomains are
# included. Leave empty to allow any public host; set it in production to limit
# the resolver to the providers you have authorization for.
# Example: ALLOWED_EMBED_HOSTS=archive.org,tube.example.org
ALLOWED_EMBED_HOSTS=

# Comma-separated denylist, applied to the entry URL and to every redirect hop.
# The denylist always wins over the allowlist.
BLOCKED_EMBED_HOSTS=

# Permit resolving private, loopback and link-local addresses.
# This disables the SSRF address checks. Never enable in production; it exists
# for testing against a local media server.
ALLOW_PRIVATE_NETWORK=false

# --- Logging ---------------------------------------------------------------

# debug | info | warn | error
LOG_LEVEL=info
